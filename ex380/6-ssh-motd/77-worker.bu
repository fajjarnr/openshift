variant: openshift
version: 4.14.0
metadata:
  labels:
    machineconfiguration.openshift.io/role: worker
  name: 77-custom-worker-motd
storage:
  files:
    - path: /etc/motd
      mode: 0444
      overwrite: true
      contents:
        inline: |
          OPENSHIFT
          Welcome to your OpenShift 4.14 Worker Node!